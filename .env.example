# ============================================================
# DISCORD BOT - VERIFICAÇÃO DE CALOIROS ESTG IPP
# Copia este ficheiro para .env e preenche com os teus dados
# ============================================================

# --- DISCORD ---
# Token do teu Bot (obtido em https://discord.com/developers/applications)
DISCORD_TOKEN=

# ID do servidor Discord (clica com o botão direito no servidor -> Copiar ID)
DISCORD_GUILD_ID=

# ID do cargo a atribuir ao caloiro verificado (clica no cargo com o botão direito -> Copiar ID)
ROLE_ID=

# --- MICROSOFT AZURE (OAuth2) ---
# Client ID da tua aplicação Azure (Azure Portal -> App Registrations -> Overview)
MS_CLIENT_ID=

# Client Secret (Azure Portal -> App Registrations -> Certificates & Secrets)
MS_CLIENT_SECRET=

# --- SERVIDOR WEB ---
# URL pública onde o bot está hospedado (usado para o callbackURL do OAuth2)
# Em desenvolvimento local usa: http://localhost:3000
# Em produção usa o teu domínio real: https://meudominio.com
BASE_URL=http://localhost:3000

# Porta onde o servidor web vai correr
PORT=3000

# Segredo para encriptação de sessões (usa uma string longa e aleatória)
SESSION_SECRET=muda_isto_para_um_segredo_longo_e_aleatorio_123!
